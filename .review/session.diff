+// v2 loop timing (serial PERF): where loop() spends its time, to find what makes the page or screen slow
+enum PerfSlot : uint8_t { PF_LOOP = 0, PF_DISPLAY, PF_WEB, PF_DEMO, PF_MESH, PF_COUNT };
