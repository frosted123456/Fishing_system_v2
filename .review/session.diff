+  uint8_t i; uint32_t t0;
+  explicit PerfScope(uint8_t k) : i(k), t0(micros()) {}
+  ~PerfScope() { const uint32_t d = micros() - t0; PerfAcc& a = perfAcc[i]; a.sum_us += d; if (d > a.max_us) a.max_us = d; a.n++; }
